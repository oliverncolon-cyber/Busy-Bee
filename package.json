{
  "name": "busy-bee",
  "version": "1.0.0",
  "description": "Busy Bee - Ambient Wearable AI Copilot for Bee Wearable & Apple Watch. Detects actionable dialogue in real-time and triggers 1-click Calendar scheduling, Amazon shopping re-orders, and Bee tasks.",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --port 5173",
    "dev": "concurrently -n \"BEDROCK-API,VITE-UI\" -c \"yellow,cyan\" --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "start": "node server/index.js"
  },
  "keywords": [
    "bee-wearable",
    "ambient-ai",
    "amazon-hackathon",
    "aws-bedrock",
    "mcp",
    "model-context-protocol",
    "alexa-plus",
    "wearable-ai"
  ],
  "author": "Oliver",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliverncolon-cyber/Busy-Bee.git"
  },
  "homepage": "https://github.com/oliverncolon-cyber/Busy-Bee#readme",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
