# ========================================================
# Busy Bee — Environment Configuration
# Ambient Wearable AI Copilot for Bee & Apple Watch
# ========================================================

PORT=3002

# AWS Bedrock Configuration (AWS Builder Mini Challenge)
# Supports Claude 3.5 Sonnet, Amazon Titan, Amazon Nova Pro/Lite
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bee Wearable CLI & MCP Settings
BEE_CLI_COMMAND=bee
BEE_PROXY_URL=http://127.0.0.1:3000
